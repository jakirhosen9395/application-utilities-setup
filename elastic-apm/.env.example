# Elasticsearch superuser password.
# Change this before setup.
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD

# Kibana system user password.
# Change this before setup.
KIBANA_PASSWORD=CHANGE_ME_KIBANA_PASSWORD

# Kibana saved objects encryption key.
# Must be exactly 32 characters.
# Generate with: openssl rand -base64 32 | head -c 32
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHARACTER_KEY_HERE

# Fleet enrollment token. Leave empty unless you need Fleet enrollment.
FLEET_ENROLLMENT_TOKEN=

# APM secret token.
# Change this before setup.
APM_SECRET_TOKEN=CHANGE_ME_APM_SECRET_TOKEN
